{
  "name": "ghostshare",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "migrate:links": "bun --env-file=apps/web/.env.local apps/web/scripts/migrate-song-links.ts"
  },
  "devDependencies": {
    "prisma": "6",
    "turbo": "^2.11.10"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "6"
  }
}
