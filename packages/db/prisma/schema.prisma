generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Song {
  id           String   @id @default(cuid())
  slug         String   @unique
  dedupeKey    String   @unique
  title        String
  artist       String
  thumbnailUrl String?
  links        String   // JSON string of { platform: url }
  createdAt    DateTime @default(now())
}